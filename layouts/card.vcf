BEGIN:VCARD
VERSION:3.0
FN:{{ site.Params.card.name }}
N:{{ site.Params.card.name }};;;;
TITLE:{{ site.Params.card.title }}
TEL;TYPE=CELL:{{ site.Params.card.phone }}
EMAIL;TYPE=INTERNET:{{ site.Params.card.email }}
ADR;TYPE=WORK:;;{{ site.Params.card.location.line1 }};{{ site.Params.card.location.line2 }};;France
{{ with site.GetPage "/" }}URL:{{ .Permalink }}{{ end }}
END:VCARD
