BEGIN:VCARD
VERSION:3.0
FN:{{ site.Params.card.name }}
N:{{ site.Params.card.name }};;;;
TITLE:{{ site.Params.card.title }}
TEL;TYPE=CELL:{{ site.Params.card.phone }}
EMAIL;TYPE=INTERNET:{{ site.Params.card.email }}
ADR;TYPE=WORK:;;{{ site.Params.card.location.city }};;;{{ site.Params.card.location.country }}
CALADRURI:{{ site.Params.card.caladr }}
{{ with site.GetPage "/" }}URL:{{ .Permalink }}
LOGO;TYPE=PNG:{{ .Permalink  }}{{ strings.TrimPrefix "/" site.Params.header.logo.image }}{{ end }}
END:VCARD
